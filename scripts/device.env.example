# scripts/device.env にコピーして、自分の値を入れる（device.env は git に入れない）
#   cp scripts/device.env.example scripts/device.env
#
# Team ID: Xcode で一度実機ビルドした後に
#   grep -m1 DEVELOPMENT_TEAM LogPhoto.xcodeproj/project.pbxproj
# DEVICE: xcrun devicectl list devices の Identifier（UDID）
# BUNDLE_ID: Xcode の Signing & Capabilities で決めた自分用の ID
TEAM_ID=XXXXXXXXXX
DEVICE=00000000-0000000000000000
BUNDLE_ID=com.yourname.logphoto
